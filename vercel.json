{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/Portfolio.dc(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/Case(.*)Study.dc(.*)",
      "destination": "/case1",
      "permanent": true
    },
    {
      "source": "/resume",
      "destination": "/resume.pdf",
      "permanent": false
    },
    {
      "source": "/credentials.html",
      "destination": "/credentials",
      "permanent": true
    },
    {
      "source": "/case1.html",
      "destination": "/case1",
      "permanent": true
    },
    {
      "source": "/case2.html",
      "destination": "/case2",
      "permanent": true
    },
    {
      "source": "/case1-2",
      "destination": "/case2",
      "permanent": true
    },
    {
      "source": "/case1-2.html",
      "destination": "/case2",
      "permanent": true
    },
    {
      "source": "/case-study-2",
      "destination": "/case2",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/(_ds|assets)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/assets/favicon.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    }
  }
}
