+    const init = () => { this.setState({ theme: window.JUHTheme.get() }); window.JUHTheme.reveal(); };
+    this.onTheme = e => this.setState({ theme: e.detail });
+    window.addEventListener('juh-theme', this.onTheme);
+    if (window.JUHTheme) init();
+    else { const iv = setInterval(() => { if (window.JUHTheme) { clearInterval(iv); init(); } }, 30); }
+    if (!window.JUH_CERTS) {
+      this.certTimer = setInterval(() => { if (window.JUH_CERTS) { clearInterval(this.certTimer); this.setState({ ready: true }); } }, 30);
+    }
+  }
+  componentWillUnmount() { window.removeEventListener('juh-theme', this.onTheme); clearInterval(this.certTimer); }
+  renderVals() {
+    const cur = this.state.theme;
+    const T = (typeof window !== 'undefined' && window.JUHTheme) ? window.JUHTheme.THEMES : { horizon: { label: 'Horizon' }, classical: { label: 'Paper' }, mono: { label: 'Mono' } };
+    const all = (typeof window !== 'undefined' && window.JUH_CERTS) || [];
+    const FILTERS = (typeof window !== 'undefined' && window.JUH_CERT_FILTERS) || [];
+    const f = this.state.filter;
+    const list = all.filter(c => f === 'all' || (f === 'featured' ? c[5] : c[0] === f));
+    const shown = f === 'all' && !this.state.expanded ? list.slice(0, PAGE) : list;
