+      themeOpts: Object.keys(T).map(k => ({
+        label: T[k].label, desc: T[k].desc, checked: k === cur ? 'true' : 'false',
+        bg: k === cur ? 'color-mix(in srgb, var(--color-accent) 16%, transparent)' : 'transparent',
+        fg: k === cur ? 'var(--color-accent)' : 'var(--color-text)',
+        pick: () => window.JUHTheme && window.JUHTheme.set(k)
+      })),
+      certFilters: FILTERS.map(([k, label]) => ({
+        label, selected: k === f ? 'true' : 'false',
+        border: k === f ? 'var(--color-accent)' : 'var(--color-divider)',
+        fg: k === f ? 'var(--color-accent)' : 'var(--color-text)',
+        bg: k === f ? 'color-mix(in srgb, var(--color-accent) 10%, transparent)' : 'transparent',
+        pick: () => this.setState({ filter: k, expanded: false })
+      })),
+      certs: shown.map(c => ({ title: c[1], issuer: c[2], date: c[3], href: c[4] || undefined, action: c[4] ? 'Verify ↗' : 'ID ESD-037/10/2025' })),
+      canShowMore: f === 'all' && list.length > PAGE,
+      showMoreLabel: this.state.expanded ? 'Show fewer' : 'Show every certification',
+      showMore: () => this.setState(s => ({ expanded: !s.expanded }))
+    };
+  }
+}
+</script>
