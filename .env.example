# Copy to .env for local use, or set these in your host's dashboard (Vercel: Project Settings → Environment Variables).
# Never commit a real key.

# Required for the live "Ask Jawad" agent. Without it, POST /api/agent returns 503
# and the agent falls back to its built-in answers.
ANTHROPIC_API_KEY=

# Optional alternative to ANTHROPIC_API_KEY (bearer token auth).
# ANTHROPIC_AUTH_TOKEN=

# Port for the Express server (npm run dev / npm start). Ignored on Vercel.
PORT=3000
